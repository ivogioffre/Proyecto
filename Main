import customtkinter as ctk
from PIL import Image
import agregar_musica
import json_utils

# --- CONFIGURACIÓN ---
ctk.set_appearance_mode("dark")
ctk.set_default_color_theme("blue")


class Reproductor:
    def __init__(self, root):

        # --- VENTANA ---
        self.root = root
        self.root.geometry("1200x700")
        self.root.title("Nickify")

        self.sidebar_visible = True

        # guardar imágenes para que no desaparezcan
        self.imagenes = []

        # Cargar canciones desde el JSON
        self.canciones = json_utils.cargar_canciones()

        # --- TOPBAR GLOBAL ---
        self.topbar = ctk.CTkFrame(root, height=50, fg_color="#0d0d0d")
        self.topbar.pack(fill="x")

        # Botón (mostrar/ocultar sidebar)
        self.btn_toggle = ctk.CTkButton(
            self.topbar,
            text="☰",
            width=40,
            fg_color="#ff00ff",
            hover_color="#ff66ff",
            text_color="black",
            command=self.toggle_sidebar
        )
        self.btn_toggle.pack(side="left", padx=10, pady=5)

        # --- CONTENEDOR ---
        self.container = ctk.CTkFrame(root, fg_color="#0a0a0a")
        self.container.pack(fill="both", expand=True)

        # --- BARRA ---
        self.sidebar = ctk.CTkFrame(self.container, width=200, fg_color="#050505")
        self.sidebar.pack(side="left", fill="y")

        # Crear botones con icono + texto
        self.btn_inicio = self.crear_boton("Inicio", "imagenes/inicio.png")
        self.btn_biblioteca = self.crear_boton("Biblioteca", "imagenes/biblioteca.png")
        self.btn_guardado = self.crear_boton("Agregar Música", "imagenes/guardado.png")

        self.btn_inicio.pack(pady=20, padx=10, fill="x")
        self.btn_biblioteca.pack(pady=20, padx=10, fill="x")
        self.btn_guardado.pack(pady=20, padx=10, fill="x")

        # Conectar el botón con la función externa
        self.btn_guardado.configure(
            command=lambda: agregar_musica.agregar_musica(self)
        )

        # --- MAIN ---
        self.main = ctk.CTkFrame(self.container, fg_color="#140028")
        self.main.pack(side="right", fill="both", expand=True)

        # --- TOPBAR INTERNA ---
        self.topbar_main = ctk.CTkFrame(self.main, height=60, fg_color="#1f003d")
        self.topbar_main.pack(fill="x")

        # --- LOGO CON IMAGEN ---
        try:
            self.logo_img = ctk.CTkImage(
                light_image=Image.open("imagenes/logo.png"),
                dark_image=Image.open("imagenes/logo.png"),
                size=(120, 60)
            )
            self.imagenes.append(self.logo_img)

            self.logo = ctk.CTkLabel(
                self.topbar_main,
                image=self.logo_img,
                text=""
            )
        except Exception as e:
            print(f"No se pudo cargar el logo: {e}")
            self.logo = ctk.CTkLabel(
                self.topbar_main,
                text="Nickify",
                text_color="#00ffff"
            )

        self.logo.pack(side="left", padx=12)

        # Texto Nickify con estética neón
        self.logo_texto = ctk.CTkLabel(
            self.topbar_main,
            text="Nickify",
            text_color="#00ffff",
            font=("Arial", 22, "bold")
        )
        self.logo_texto.pack(side="left", padx=5)

        # Buscador
        self.buscador = ctk.CTkEntry(
            self.topbar_main,
            placeholder_text="Buscar...",
            width=500,
            fg_color="#0d0d0d",
            text_color="white",
            border_color="#ff00ff"
        )
        self.buscador.pack(side="left", padx=20, pady=10)

        # --- CONTENIDO ---
        self.content = ctk.CTkFrame(self.main, fg_color="#1a0033")
        self.content.pack(fill="both", expand=True)

        # Área desplazable para mostrar las canciones
        self.scroll_canciones = ctk.CTkScrollableFrame(
            self.content,
            fg_color="#1a0033"
        )
        self.scroll_canciones.pack(fill="both", expand=True, padx=10, pady=10)

        # Mostrar las canciones cargadas desde el JSON
        for cancion in self.canciones:
            agregar_musica.mostrar_cancion(self, cancion)

    # --- CREAR BOTON CON ICONO ---
    def crear_boton(self, texto, ruta_imagen):
        img = ctk.CTkImage(
            light_image=Image.open(ruta_imagen),
            dark_image=Image.open(ruta_imagen),
            size=(35, 35)
        )
        self.imagenes.append(img)

        boton = ctk.CTkButton(
            self.sidebar,
            text=texto,
            image=img,
            compound="top",
            fg_color="#1a0033",
            hover_color="#ff00ff",
            text_color="white",
            corner_radius=10,
            height=80
        )
        return boton

    # --- MOSTRAR / OCULTAR BARRA ---
    def toggle_sidebar(self):
        if self.sidebar_visible:
            self.sidebar.pack_forget()
            self.sidebar_visible = False
        else:
            self.sidebar.pack(side="left", fill="y")
            self.sidebar_visible = True


# --- EJECUCIÓN ---
if __name__ == "__main__":
    root = ctk.CTk()
    app = Reproductor(root)
    root.mainloop()