#main
import customtkinter as ctk
from PIL import Image
import agregar_musica
import json_utils
import playlist
from reproducir import ReproductorAudio

# --- CONFIGURACIÓN ---
# Modo oscuro y tema visual
ctk.set_appearance_mode("dark")
ctk.set_default_color_theme("blue")


class Reproductor:
    def __init__(self, root):
        """
        Constructor principal de la aplicación.
        Inicializa toda la interfaz gráfica, carga datos y conecta los módulos.
        """

        # --- VENTANA ---
        self.root = root
        self.root.geometry("1200x700")
        self.root.title("Nickify")

        # Controla si la sidebar está visible o no
        self.sidebar_visible = True

        # guardar imágenes para que no desaparezcan (evita garbage collector de Tkinter)
        self.imagenes = []

        # Cargar canciones desde el JSON (persistencia)
        self.canciones = json_utils.cargar_canciones()

        # Vista activa: "inicio" o "playlist:<nombre>"
        self.vista_activa = "inicio"

        # --- TOPBAR GLOBAL ---
        self.topbar = ctk.CTkFrame(root, height=50, fg_color="#0d0d0d")
        self.topbar.pack(fill="x")

        # Botón (mostrar/ocultar sidebar)
        self.btn_toggle = ctk.CTkButton(
            self.topbar,
            text="☰",
            width=40,
            fg_color="#ff00ff",
            hover_color="#ff66ff",
            text_color="black",
            command=self.toggle_sidebar  # alterna visibilidad
        )
        self.btn_toggle.pack(side="left", padx=10, pady=5)

        # --- CONTENEDOR ---
        # Contenedor principal donde van sidebar + contenido
        self.container = ctk.CTkFrame(root, fg_color="#0a0a0a")
        self.container.pack(fill="both", expand=True)

        # --- BARRA ---
        self.sidebar = ctk.CTkFrame(self.container, width=200, fg_color="#050505")
        self.sidebar.pack(side="left", fill="y")

        # Crear botones con icono + texto
        self.btn_inicio = self.crear_boton("Inicio", "imagenes/inicio.png")
        self.btn_biblioteca = self.crear_boton("Biblioteca", "imagenes/biblioteca.png")
        self.btn_guardado = self.crear_boton("Agregar Música", "imagenes/guardado.png")

        self.btn_inicio.pack(pady=20, padx=10, fill="x")
        self.btn_biblioteca.pack(pady=20, padx=10, fill="x")
        self.btn_guardado.pack(pady=20, padx=10, fill="x")

        # Configuración de acciones de botones
        self.btn_inicio.configure(command=self.mostrar_inicio)
        self.btn_biblioteca.configure(command=lambda: playlist.mostrar_biblioteca(self))

        # Conectar el botón con la función externa
        self.btn_guardado.configure(
            command=lambda: agregar_musica.agregar_musica(self)
        )

        # --- MAIN ---
        self.main = ctk.CTkFrame(self.container, fg_color="#140028")
        self.main.pack(side="right", fill="both", expand=True)

        # --- TOPBAR INTERNA ---
        self.topbar_main = ctk.CTkFrame(self.main, height=60, fg_color="#1f003d")
        self.topbar_main.pack(fill="x")

        # --- LOGO CON IMAGEN ---
        try:
            self.logo_img = ctk.CTkImage(
                light_image=Image.open("imagenes/logo.png"),
                dark_image=Image.open("imagenes/logo.png"),
                size=(120, 60)
            )
            self.imagenes.append(self.logo_img)

            self.logo = ctk.CTkLabel(
                self.topbar_main,
                image=self.logo_img,
                text=""
            )
        except Exception as e:
            print(f"No se pudo cargar el logo: {e}")
            self.logo = ctk.CTkLabel(
                self.topbar_main,
                text="Nickify",
                text_color="#00ffff"
            )

        self.logo.pack(side="left", padx=12)

        # Texto Nickify con estética neón
        self.logo_texto = ctk.CTkLabel(
            self.topbar_main,
            text="Nickify",
            text_color="#00ffff",
            font=("Arial", 22, "bold")
        )
        self.logo_texto.pack(side="left", padx=5)

        # Buscador — se conecta al método buscar()
        self.buscador = ctk.CTkEntry(
            self.topbar_main,
            placeholder_text="Buscar...",
            width=500,
            fg_color="#0d0d0d",
            text_color="white",
            border_color="#ff00ff"
        )
        self.buscador.pack(side="left", padx=20, pady=10)

        # Bind: cada tecla dispara la búsqueda en tiempo real
        self.buscador.bind("<KeyRelease>", self._on_buscar)

        # Botón limpiar búsqueda
        self.btn_limpiar_busqueda = ctk.CTkButton(
            self.topbar_main,
            text="✕",
            width=30,
            fg_color="#1a0033",
            hover_color="#ff0055",
            text_color="white",
            command=self.limpiar_busqueda
        )
        self.btn_limpiar_busqueda.pack(side="left", padx=(0, 10))

        # --- CONTENIDO ---
        self.content = ctk.CTkFrame(self.main, fg_color="#1a0033")
        self.content.pack(fill="both", expand=True)

        # Área desplazable para mostrar las canciones
        self.scroll_canciones = ctk.CTkScrollableFrame(
            self.content,
            fg_color="#1a0033"
        )
        self.scroll_canciones.pack(fill="both", expand=True, padx=10, pady=10)

        # Reproductor de audio (módulo externo)
        self.player = ReproductorAudio(self)
        self.player.crear_barra_reproductor()

        # Mostrar las canciones cargadas desde el JSON
        self.mostrar_inicio()

    def limpiar_scroll(self):
        """
        Elimina todos los widgets del área de canciones.
        También reinicia el scroll al inicio.
        """
        for widget in self.scroll_canciones.winfo_children():
            widget.destroy()

        try:
            self.scroll_canciones.update_idletasks()
            self.scroll_canciones._parent_canvas.yview_moveto(0)
        except Exception:
            pass
    
    def volver_arriba_scroll(self):
        """
        Fuerza el scroll a volver al inicio sin borrar contenido.
        """
        try:
            self.scroll_canciones.update_idletasks()
            self.scroll_canciones._parent_canvas.yview_moveto(0)
        except Exception:
            pass

    def mostrar_inicio(self):
        """
        Cambia la vista a inicio (todas las canciones).
        """
        self.vista_activa = "inicio"
        self._renderizar_vista()

    def _on_buscar(self, event=None):
        """
        Se ejecuta cada vez que el usuario escribe en el buscador.
        """
        self._renderizar_vista()

    def limpiar_busqueda(self):
        """
        Limpia el texto del buscador y actualiza la vista.
        """
        self.buscador.delete(0, "end")
        self._renderizar_vista()

    def _texto_busqueda(self):
        """
        Devuelve el texto del buscador en minúsculas.
        """
        return self.buscador.get().strip().lower()

    def _filtrar_canciones(self, lista):
        """
        Filtra una lista de canciones según el texto buscado.
        Busca coincidencias en varios campos.
        """
        query = self._texto_busqueda()
        if not query:
            return lista

        resultado = []
        for cancion in lista:
            campos = [
                cancion.get("titulo", ""),
                cancion.get("artista", ""),
                cancion.get("album", ""),
                cancion.get("genero", ""),
                cancion.get("año", ""),
            ]
            # Si el texto aparece en cualquiera de los campos → se incluye
            if any(query in campo.lower() for campo in campos):
                resultado.append(cancion)
        return resultado

    def _renderizar_vista(self):
        """
        Decide qué mostrar según la vista actual.
        """
        if self.vista_activa == "inicio":
            self._renderizar_inicio_filtrado()
        elif self.vista_activa.startswith("playlist:"):
            nombre = self.vista_activa[len("playlist:"):]
            playlist.renderizar_canciones_playlist(self, nombre)

    def _renderizar_inicio_filtrado(self):
        """
        Muestra las canciones filtradas en la vista inicio.
        """
        self.limpiar_scroll()
        query = self._texto_busqueda()
        canciones_filtradas = self._filtrar_canciones(self.canciones)

        if not canciones_filtradas:
            lbl = ctk.CTkLabel(
                self.scroll_canciones,
                text=f'No se encontraron resultados para "{query}".',
                text_color="#888888",
                font=("Arial", 15)
            )
            lbl.pack(pady=30)
            return

        # Asegura que la vista arranque arriba
        self.volver_arriba_scroll()

        for cancion in canciones_filtradas:
            # índice original para no romper reproducción
            indice_original = self.canciones.index(cancion)
            agregar_musica.mostrar_cancion(self, cancion, indice_original)

    # --- CREAR BOTON CON ICONO ---
    def crear_boton(self, texto, ruta_imagen):
        """
        Crea un botón con imagen + texto para la sidebar.
        """
        img = ctk.CTkImage(
            light_image=Image.open(ruta_imagen),
            dark_image=Image.open(ruta_imagen),
            size=(35, 35)
        )
        self.imagenes.append(img)

        boton = ctk.CTkButton(
            self.sidebar,
            text=texto,
            image=img,
            compound="top",
            fg_color="#1a0033",
            hover_color="#ff00ff",
            text_color="white",
            corner_radius=10,
            height=80
        )
        return boton

    # --- MOSTRAR / OCULTAR BARRA ---
    def toggle_sidebar(self):
        """
        Alterna la visibilidad de la barra lateral.
        """
        if self.sidebar_visible:
            self.sidebar.pack_forget()
            self.sidebar_visible = False
        else:
            self.sidebar.pack(side="left", fill="y", before=self.main)
            self.sidebar_visible = True


# --- EJECUCIÓN ---
if __name__ == "__main__":
    root = ctk.CTk()
    app = Reproductor(root)
    root.mainloop()